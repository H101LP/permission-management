<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.system.mapper.AssetMapper">

    <resultMap id="AssetResult" type="com.fast.system.domain.Asset">
        <id column="asset_id" property="assetId"/>
        <result column="asset_name" property="assetName"/>
        <result column="asset_code" property="assetCode"/>
        <result column="dept_id" property="deptId"/>
        <result column="owner_user_id" property="ownerUserId"/>
        <result column="status" property="status"/>
        <result column="price" property="price"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 列表：@DataScope(deptAlias="a") 会在 WHERE 后追加 a.dept_id 条件 -->
    <select id="selectAssetList" parameterType="Asset" resultMap="AssetResult">
        SELECT a.asset_id, a.asset_name, a.asset_code, a.dept_id,
        a.owner_user_id, a.status, a.price, a.remark, a.create_time
        FROM asset a
        <where>
            <if test="assetName != null and assetName != ''">
                AND a.asset_name LIKE CONCAT('%', #{assetName}, '%')
            </if>
            <if test="assetCode != null and assetCode != ''">
                AND a.asset_code LIKE CONCAT('%', #{assetCode}, '%')
            </if>
            <if test="status != null">
                AND a.status = #{status}
            </if>
        </where>
        ORDER BY a.asset_id ASC
    </select>

    <select id="selectAssetById" parameterType="Long" resultMap="AssetResult">
        SELECT a.asset_id, a.asset_name, a.asset_code, a.dept_id,
               a.owner_user_id, a.status, a.price, a.remark, a.create_time
        FROM asset a
        WHERE a.asset_id = #{assetId}
    </select>

    <insert id="insertAsset" parameterType="Asset" useGeneratedKeys="true" keyProperty="assetId">
        INSERT INTO asset (asset_name, asset_code, dept_id, owner_user_id, status, price, remark)
        VALUES (#{assetName}, #{assetCode}, #{deptId}, #{ownerUserId}, #{status}, #{price}, #{remark})
    </insert>

    <update id="updateAsset" parameterType="Asset">
        UPDATE asset
        <set>
            <!-- asset_name 是 NOT NULL 且更新时必传，恒定写一行保证 SET 不为空 -->
            asset_name = #{assetName},
            <if test="assetCode != null">asset_code = #{assetCode},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="ownerUserId != null">owner_user_id = #{ownerUserId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="price != null">price = #{price},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE asset_id = #{assetId}
    </update>

    <delete id="deleteAssetById" parameterType="Long">
        DELETE FROM asset WHERE asset_id = #{assetId}
    </delete>
</mapper>
