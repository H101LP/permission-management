<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.system.mapper.DeptMapper">

    <resultMap id="DeptResult" type="Dept">
        <id column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="parent_id" property="parentId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="order_num" property="orderNum"/>
        <result column="leader" property="leader"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 部门列表（平铺） -->
    <select id="selectDeptList" parameterType="Dept" resultMap="DeptResult">
        select dept_id, dept_name, parent_id, ancestors, order_num, leader, status, create_time
        from sys_dept
        <where>
            <if test="deptName != null and deptName != ''">
                and dept_name like concat('%', #{deptName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by parent_id, order_num
    </select>

    <!-- 根据ID查询 -->
    <select id="selectDeptById" parameterType="Long" resultMap="DeptResult">
        select dept_id, dept_name, parent_id, ancestors, order_num, leader, status, create_time
        from sys_dept
        where dept_id = #{deptId}
    </select>

    <!-- 新增：create_time 有数据库默认值，不用插 -->
    <insert id="insertDept" parameterType="Dept" useGeneratedKeys="true" keyProperty="deptId">
        insert into sys_dept (dept_name, parent_id, ancestors, order_num, leader, status)
        values (#{deptName}, #{parentId}, #{ancestors}, #{orderNum}, #{leader}, #{status})
    </insert>

    <!-- 修改：刻意不更新 parent_id / ancestors -->
    <update id="updateDept" parameterType="Dept">
        update sys_dept
        <set>
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="leader != null">leader = #{leader},</if>
            <if test="status != null and status != ''">status = #{status},</if>
        </set>
        where dept_id = #{deptId}
    </update>

    <delete id="deleteDeptById" parameterType="Long">
        delete from sys_dept where dept_id = #{deptId}
    </delete>
    <!-- 查询子部门数量 -->
    <select id="selectChildrenCount" parameterType="Long" resultType="int">
        select count(1) from sys_dept where parent_id = #{deptId}
    </select>

</mapper>
