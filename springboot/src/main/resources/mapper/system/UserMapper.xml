<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace：改成你自己的 Mapper 接口全路径 -->
<mapper namespace="com.fast.system.mapper.UserMapper">
    <!-- 创建 resultMap -->
    <resultMap id="UserResult" type="com.fast.system.domain.User">
        <id column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="sex" property="sex"/>
        <result column="avatar" property="avatar"/>
        <result column="password" property="password"/>
        <result column="create_time" property="createTime"/>
        <result column="role_id" property="roleId"/>
        <result column="role_name" property="roleName"/>
    </resultMap>



    <!-- 根据用户名查询用户 -->
    <select id="selectByUserName" resultMap="UserResult" parameterType="String">
        select user_id,user_name,sex,avatar,password,create_time
        from user where user_name = #{userName}
    </select>
    <!-- 根据用户ID查询用户 -->
    <select id="selectByUserUserId" resultMap="UserResult" parameterType="Long">
        select u.user_id,u.user_name,u.sex,u.avatar,u.password,u.create_time
             ,ur.role_id,r.role_name
        from user u
        left join user_role ur on u.user_id = ur.user_id
        left join role r on ur.role_id = r.role_id
        where u.user_id = #{userId}
    </select>
    <!--查询用户列表-->
    <select id="selectUserList" resultMap="UserResult" parameterType="User">
        select u.user_id,u.user_name,u.sex,u.avatar,u.password,u.create_time
             ,ur.role_id,r.role_name
        from user u
        left join user_role ur on u.user_id = ur.user_id
        left join role r on ur.role_id = r.role_id
        <where>
          <if test="userId != null">
            and u.user_id = #{userId}
          </if>
          <if test="userName != null and userName != ''">
            and u.user_name like CONCAT('%', #{userName}, '%')
          </if>
        </where>
        order by u.user_id asc
    </select>
    <!-- 新增用户 -->
    <!--
    useGeneratedKeys="true" keyProperty="userId"
    解释：useGeneratedKeys="true" 表示使用数据库生成的主键值，
    keyProperty="userId" 表示将生成的主键值赋给 User 对象的 userId 属性。
    -->
    <insert id="insertUser" parameterType="User" useGeneratedKeys="true" keyProperty="userId">
        insert into user
        <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="userId !=null">user_id,</if>
        <if test="userName !=null and userName != ''">user_name,</if>
        <if test="sex !=null">sex,</if>
        <if test="avatar !=null and avatar != ''">avatar,</if>
        <if test="password !=null and password != ''">password,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
        <if test="userId !=null">#{userId},</if>
        <if test="userName !=null and userName != ''">#{userName},</if>
        <if test="sex !=null">#{sex},</if>
        <if test="avatar !=null and avatar != ''">#{avatar},</if>
        <if test="password !=null and password != ''">#{password},</if>
        </trim>


    </insert>
    <!--更新用户头像-->
    <update id="updateUserAvatar" parameterType="User">
        update user set avatar = #{avatar} where user_id = #{userId}
    </update>
    <!--更新用户信息-->
    <update id="updateUser" parameterType="User">
        update user
        <set>
        <if test="userName != null and userName != ''">user_name = #{userName},</if>
        <if test="sex != null">sex = #{sex},</if>
        <if test="password != null and password != ''">password = #{password},</if>
        </set>
        where user_id = #{userId}
    </update>
    <!--重置密码-->
    <update id="resetUserPwd" parameterType="User">
        update user
        set password = #{newPassword}
        where user_id = #{userId}
    </update>

    <!--删除用户-->
    <delete id="deleteUserByUserIds">
        delete from user where user_id in
        <foreach collection="userIdArray" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
    </delete>
    
    
    
</mapper>