<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.system.mapper.SysOperationLogMapper">
    <!--结果映射-->
    <resultMap id="OperationLogResult" type="com.fast.system.domain.SysOperationLog">
        <id     column="log_id"          property="logId"/>
        <result column="user_id"         property="userId"/>
        <result column="user_name"       property="userName"/>
        <result column="module"          property="module"/>
        <result column="business"        property="business"/>
        <result column="oper_type"       property="operType"/>
        <result column="request_uri"     property="requestUri"/>
        <result column="request_method"  property="requestMethod"/>
        <result column="request_param"   property="requestParam"/>
        <result column="result"          property="result"/>
        <result column="cost_time"       property="costTime"/>
        <result column="status"          property="status"/>
        <result column="trace_id"        property="traceId"/>
        <result column="oper_time"       property="operTime"/>
    </resultMap>
    <!--插入-->
    <insert id="insertLog" parameterType="com.fast.system.domain.SysOperationLog" useGeneratedKeys="true" keyProperty="logId">
        insert into sys_operation_log (
            user_id, user_name, module, business, oper_type,
            request_uri, request_method, request_param, result,
            cost_time, status, trace_id, oper_time
        ) values (
                     #{userId}, #{userName}, #{module}, #{business}, #{operType},
                     #{requestUri}, #{requestMethod}, #{requestParam}, #{result},
                     #{costTime}, #{status}, #{traceId}, now()
                 )
    </insert>
    <!--
      查询列表。
      这里不写 limit，PageHelper 会在执行前自动拦截加 limit 和 count。
      beginTime/endTime 是纯查询参数，前端传 'YYYY-MM-DD'，
      这里用 concat 补成 'YYYY-MM-DD 00:00:00' / 'YYYY-MM-DD 23:59:59'，
      避免"选了 11-17 却查不到 11-17 当天数据"。
    -->
    <select id="selectOperationLogList"
            parameterType="com.fast.system.domain.SysOperationLog"
            resultMap="OperationLogResult">
        select log_id, user_id, user_name, module, business, oper_type,
        request_uri, request_method, request_param, result,
        cost_time, status, trace_id, oper_time
        from sys_operation_log
        <where>
            <if test="module != null and module != ''">
                and module = #{module}
            </if>
            <if test="operType != null and operType != ''">
                and oper_type = #{operType}
            </if>
            <!-- status 是 Integer，0 也要能匹配，所以不能写 status != null and status != '' -->
            <if test="status != null">
                and status = #{status}
            </if>
            <if test="userName != null and userName != ''">
                and user_name like concat('%', #{userName}, '%')
            </if>
            <if test="beginTime != null and beginTime != ''">
                and oper_time &gt;= concat(#{beginTime}, ' 00:00:00')
            </if>
            <if test="endTime != null and endTime != ''">
                and oper_time &lt;= concat(#{endTime}, ' 23:59:59')
            </if>
        </where>
        order by oper_time desc
    </select>
</mapper>